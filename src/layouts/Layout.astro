---
import { SEO } from "astro-seo";
import "../styles/global.css";
import NavigationMenu from "@layouts/navbar.astro";

import "@fortawesome/fontawesome-svg-core/styles.css";
import { config } from "@fortawesome/fontawesome-svg-core";
config.autoAddCss = false;

interface Props {
    title: string;
    description: string;
    type?: "website" | "article";
}
const { title, description, type = "website" } = Astro.props;
const pagetitle = `svtplay-dl - ${title}`;
---

<html lang="en">
    <head>
        <SEO
            title={pagetitle}
            description={description}
            openGraph={{
                basic: {
                    title: pagetitle,
                    type: type,
                    image: "https://svtplay-dl.se/og-image.png",
                },
                optional: {
                    description: description,
                    siteName: "svtplay-dl",
                },
                image: {
                    width: 1200,
                    height: 630,
                    alt: "svtplay-dl",
                },
            }}
            twitter={{
                card: "summary_large_image",
                title: pagetitle,
                description: description,
                image: "https://svtplay-dl.se/og-image.png",
                imageAlt: "svtplay-dl",
            }}
        />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="svtplay-dl" />
        <link rel="manifest" href="/site.webmanifest" />
        {
            import.meta.env.PROD && (
                <>
                    <script
                        is:inline
                        async
                        defer
                        data-domain="svtplay-dl.se"
                        src="https://metrics.i19.se/pls.js"
                    />
                    <script
                        is:inline
                        async
                        src="https://www.googletagmanager.com/gtag/js?id=G-31DC2XP3C7"
                    />
                    <script
                        is:inline
                        set:html={`
                            window.dataLayer = window.dataLayer || [];
                            function gtag() {
                                dataLayer.push(arguments);
                            }
                            gtag("js", new Date());
                            gtag("config", "G-31DC2XP3C7");
                            `}
                    />
                </>
            )
        }
    </head>
    <body class="antialiased text-base bg-gray-50 dark:bg-gray-900 min-h-screen flex flex-col">
        <a
            href="#main-content"
            class="sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:not-sr-only focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
            Skip to main content
        </a>
        <div class="w-full max-w-7xl mx-auto px-4 flex-1 flex flex-col">
            <header class="mb-8">
                <div class="flex items-center justify-between w-full">
                    <a
                        href="/"
                        class="flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-gray-100">
                        <img src="/logo.svg" alt="" aria-hidden="true" width="24" height="24" />
                        svtplay-dl
                    </a>
                    <NavigationMenu />
                </div>
            </header>

            <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
                <slot />
            </main>

            <footer class="bg-gray-300 dark:bg-gray-800 mt-8 rounded-lg shadow-sm">
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 p-6 text-gray-900 dark:text-gray-100">
                    <div>
                        <h2 class="text-base font-medium mb-1">Chat</h2>
                        <a
                            href="https://discord.gg/ytaUbWtAkB"
                            class="text-sm text-blue-700 underline hover:no-underline dark:text-blue-300">
                            Discord
                        </a>
                    </div>
                    <div>
                        <h2 class="text-base font-medium mb-1">Bugs and Issues</h2>
                        <a
                            href="https://github.com/spaam/svtplay-dl/issues"
                            class="text-sm text-blue-700 underline hover:no-underline dark:text-blue-300">
                            Github
                        </a>
                    </div>
                    <div>
                        <h2 class="text-base font-medium mb-1">Contribute</h2>
                        <a
                            href="https://github.com/spaam/svtplay-dl"
                            class="text-sm text-blue-700 underline hover:no-underline dark:text-blue-300">
                            Github
                        </a>
                    </div>
                    <div>
                        <h2 class="text-base font-medium mb-1">License</h2>
                        <a
                            href="https://github.com/spaam/svtplay-dl/blob/master/LICENSE"
                            class="text-sm text-blue-700 underline hover:no-underline dark:text-blue-300">
                            MIT
                        </a>
                        <br />© 2011-2025 Johan Andersson et al
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>
