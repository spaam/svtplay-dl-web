---
import Layout from "../../layouts/Layout.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";

import { faGlobe } from "@fortawesome/free-solid-svg-icons";

const pageTitle = "Supported Sites";
const description = "Current supported sites for svtplay-dl";
---

<Layout title={pageTitle} description={description}>
    <div class="grid">
        <h1 class="text-4xl">
            {pageTitle}
            <FontAwesomeIcon icon={faGlobe} />
        </h1>
        <hr class="mt-4 mb-4" />
    </div>
    <div class="text-xl">
        <div class="mt-4">
            <div class="grid auto-cols-max grid-flow-col w-full max-w-7xl p-4 grid-cols-1 md:grid-cols-3">
                <div>
                    <h2 class="text-2xl">A-L</h2>
                    <div>
                        <ul>
                            <li><a href="/aftonbladet" class="text-blue-700 underline hover:no-underline dark:text-blue-300">aftonbladet.se</a></li>
                            <li>dbtv.no</li>
                            <li>di.se</li>
                            <li>dn.se</li>
                            <li>dr.dk</li>
                            <li>efn.se</li>
                            <li>expressen.se</li>
                            <li>filmarkivet.se</li>
                            <li>flowonline.tv</li>
                        </ul>
                    </div>
                </div>
                <div>
                    <h2 class="text-2xl">M-S</h2>
                    <div>
                        <ul>
                            <li>nickelodeon.nl</li>
                            <li>nickelodeon.no</li>
                            <li>nickelodeon.se</li>
                            <li>nrk.no</li>
                            <li>oppetarkiv.se</li>
                            <li>regeringen.se</li>
                            <li>ruv.is</li>
                            <li>riksdagen.se</li>
                            <li>svd.se</li>
                            <li>sverigesradio.se</li>
                            <li>svtplay.se</li>
                        </ul>
                    </div>
                </div>
                <div>
                    <h2 class="text-2xl">T-Z</h2>
                    <div>
                        <ul>
                            <li>tv3play.ee</li>
                            <li>tv3play.lt</li>
                            <li>tv3play.lv</li>
                            <li>tv4.se</li>
                            <li><a href="/tv4play" class="text-blue-700 underline hover:no-underline dark:text-blue-300">tv4play.se</a></li>
                            <li>ur.se</li>
                            <li>urplay.se</li>
                            <li>vasaloppet.se</li>
                            <li>vg.no</li>
                            <li>viasat4play.no</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
