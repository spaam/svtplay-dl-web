---
import Layout from "../../layouts/Layout.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faCircleInfo } from "@fortawesome/free-solid-svg-icons";

const pageTitle = "About";
const description =
    "Small command-line program written in python to download videos from various sites";

const components: { title: string; href: string }[] = [
    {
        title: "PYPI",
        href: "https://img.shields.io/pypi/status/svtplay-dl.svg",
    },
    {
        title: "PYPI",
        href: "https://img.shields.io/pypi/pyversions/svtplay-dl.svg",
    },
    {
        title: "License",
        href: "https://img.shields.io/github/license/spaam/svtplay-dl.svg",
    },
    {
        title: "GitHub contributors",
        href: "https://img.shields.io/github/contributors/spaam/svtplay-dl.svg",
    },
    {
        title: "GitHub last commit",
        href: "https://img.shields.io/github/last-commit/spaam/svtplay-dl.svg",
    },
    {
        title: "GitHub commit activity the past week, 4 weeks, year",
        href: "https://img.shields.io/github/commit-activity/y/spaam/svtplay-dl.svg",
    },
    {
        title: "PyPI",
        href: "https://img.shields.io/pypi/v/svtplay-dl.svg",
    },
    {
        title: "GitHub issues",
        href: "https://img.shields.io/github/issues/spaam/svtplay-dl.svg",
    },
    {
        title: "GitHub pull requests",
        href: "https://img.shields.io/github/issues-pr/spaam/svtplay-dl.svg",
    },
];
---

<Layout title={pageTitle} description={description}>
    <div class="grid">
        <h1 class="text-4xl">
            {pageTitle}
            <FontAwesomeIcon icon={faCircleInfo} />
        </h1>
        <hr class="mt-4 mb-4" />
    </div>
    <div class="text-xl">
        <div>
            <div class="flex flex-wrap items-center gap-2">
                {
                    components.map((component) => (
                        <img
                            src={component.href}
                            class="h-5 w-auto inline-block"
                            alt={component.title}
                        />
                    ))
                }
            </div>
        </div>
        <div class="text-xl">
            Small command-line program written in
            <a href="https://www.python.org" class="text-blue-500"> python </a>
            to download videos from various
            <a href="/sites" class="text-blue-500"> sites </a>.
        </div>
        <div class="text-xl mt-4">
            Source code available in
            <a href="https://github.com/spaam/svtplay-dl" class="text-blue-500"> GitHub </a>
        </div>
    </div>
</Layout>
