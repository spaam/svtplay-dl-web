---
import Layout from "../../../layouts/Layout.astro";
import { Code } from "astro:components";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faDocker } from "@fortawesome/free-brands-svg-icons";

const pageTitle = "Install on Docker";
const description = "Installation instructions for svtplay-dl on Docker";

const pullcontainer = `docker pull spaam/svtplay-dl`;
const runcontainer = `docker run -it --rm  -u $(id -u):$(id -g)  -v "$(pwd):/data" spaam/svtplay-dl`;
const bash = `alias svtplay-dl='docker run -it --rm -u $(id -u):$(id -g) -v "$(pwd):/data" spaam/svtplay-dl'`;
const zsh = `alias svtplay-dl='docker run -it --rm -u $(id -u):$(id -g) -v "$(pwd):/data" spaam/svtplay-dl'`;
const fish = `alias svtplay-dl='docker run -it --rm -u (id -u):(id -g) -v (pwd):/data spaam/svtplay-dl'`;
---

<Layout title={pageTitle} description={description}>
    <div class="grid">
        <h1 class="text-4xl">
            {pageTitle}
            <FontAwesomeIcon icon={faDocker} />
        </h1>
        <hr class="mt-4 mb-4" />
    </div>
    <div class="text-xl">
        <div class="mt-4">
            <h2 class="text-3xl">Pull the container</h2>
            <div>
                <div class="p-6">
                    <div class="rounded-xl overflow-x-auto bg-[#2b2b2b] text-sm">
                        <Code
                            theme="dark-plus"
                            class="p-4"
                            theme="dark-plus"
                            class="p-4"
                            lang="bash"
                            code={pullcontainer}
                        />
                    </div>
                </div>
            </div>
            <div>
                tags for each version since 2.1. there is also a tag for latest master called
                <span class="text-pink-700 dark:text-pink-300">dev</span> see{" "}
                <a href="https://hub.docker.com/r/spaam/svtplay-dl" class="text-blue-700 underline hover:no-underline dark:text-blue-300">
                    https://hub.docker.com/r/spaam/svtplay-dl
                </a>
            </div>
            <div>
                <div class="p-6">
                    <div class="rounded-xl overflow-x-auto bg-[#2b2b2b] text-sm">
                        <Code
                            theme="dark-plus"
                            class="p-4"
                            theme="dark-plus"
                            class="p-4"
                            lang="bash"
                            code={runcontainer}
                        />
                    </div>
                </div>
            </div>
            <div>or create an alias:</div>
            <h3>bash (~/.bashrc)</h3>
            <div>
                <div class="p-6">
                    <div class="rounded-xl overflow-x-auto bg-[#2b2b2b] text-sm">
                        <Code
                            theme="dark-plus"
                            class="p-4"
                            theme="dark-plus"
                            class="p-4"
                            lang="bash"
                            code={bash}
                        />
                    </div>
                </div>
            </div>
            <h3>zsh (~/.zshrc)</h3>
            <div>
                <div class="p-6">
                    <div class="rounded-xl overflow-x-auto bg-[#2b2b2b] text-sm">
                        <Code
                            theme="dark-plus"
                            class="p-4"
                            theme="dark-plus"
                            class="p-4"
                            lang="bash"
                            code={zsh}
                        />
                    </div>
                </div>
            </div>
            <h3>fish (~/.config/fish/config.fish)</h3>
            <div>
                <div class="p-6">
                    <div class="rounded-xl overflow-x-auto bg-[#2b2b2b] text-sm">
                        <Code
                            theme="dark-plus"
                            class="p-4"
                            theme="dark-plus"
                            class="p-4"
                            lang="bash"
                            code={fish}
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
