---
import Layout from "../../layouts/Layout.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { Code } from "astro:components";
import { faFolderOpen } from "@fortawesome/free-solid-svg-icons";

const pageTitle = "Aftonbladet";
const description =
    "How to find your Aftonbladet Plus access token and use it with svtplay-dl to download premium/paywalled videos.";
const config = `service:
  aftonbladet:
    token: "ey..."
`;
---

<Layout title={pageTitle} description={description}>
    <div class="grid">
        <h1 class="text-4xl">
            {pageTitle}
            <FontAwesomeIcon icon={faFolderOpen} />
        </h1>
        <hr class="mt-4 mb-4" />
    </div>
    <div class="text-xl">
        <div class="mt-4">
            Login to aftonbladet, press <span class="text-pink-700 dark:text-pink-300">ctrl + shift + i</span> or <span
                class="text-pink-700 dark:text-pink-300">F12</span
            >, then press <span class="text-pink-700 dark:text-pink-300">network</span> tab. then go to the aftonbladet plus
            video, find the call <span class="text-pink-700 dark:text-pink-300">?access=plus</span> in the network tab.
            <br />
            <img
                src="/assets/network.png"
                alt="Browser developer tools with the Network tab and an access request highlighted"
                width="369"
                height="248"
                loading="lazy"
                decoding="async"
                class="h-auto max-w-full"
            />
            <br />

            go to the request headers and scroll down to the header:
            <span class="text-pink-700 dark:text-pink-300">x-sp-id</span>
            Copy that text that starts with <span class="text-pink-700 dark:text-pink-300">ey..</span><br />
            <img
                src="/assets/headers.png"
                alt="Request Headers panel with the x-sp-id header highlighted"
                width="131"
                height="611"
                loading="lazy"
                decoding="async"
                class="h-auto max-w-full"
            />
            <br />

            then you can use it like this:
            <span class="text-pink-700 dark:text-pink-300"
                >svtplay-dl --token "ey.." https://www.aftonbladet.se/..</span
            >

            or use put it in the <a href="/config" class="text-blue-700 underline hover:no-underline dark:text-blue-300">config</a> like this for example

            <div class="p-6">
                <div class="rounded-xl overflow-x-auto bg-[#2b2b2b] text-sm">
                    <Code theme="dark-plus" class="p-4" lang="bash" code={config} />
                </div>
            </div>
        </div>
    </div>
</Layout>
